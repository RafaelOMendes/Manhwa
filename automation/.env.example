# Copie este arquivo para "automation/.env" e preencha os valores.
# NUNCA commite o .env de verdade (ele já está no .gitignore).
# O passo a passo completo de onde conseguir cada valor está em automation/SETUP.md.

# --- Trello -----------------------------------------------------------------
# Chave e token de API: https://trello.com/power-ups/admin -> "New" -> API Key
# (o token é gerado clicando no link "Token" que aparece do lado da API Key)
TRELLO_KEY=
TRELLO_TOKEN=
# ID do board: abra o board, adicione ".json" no final da URL, procure por "id" no topo
TRELLO_BOARD_ID=

# Nomes EXATOS das listas (colunas) do seu board do Trello, como aparecem na tela.
TRELLO_LIST_DOING=Em Andamento
TRELLO_LIST_DEV=Em Desenvolvimento
TRELLO_LIST_TEST=Teste
TRELLO_LIST_DONE=Concluído

# --- Claude Code CLI ----------------------------------------------------------
# Deixe em branco se "claude" já funciona no seu terminal (PATH). Só preencha se
# precisar apontar pro executável exato.
CLAUDE_CLI_PATH=

# Modelo usado só pra REESCREVER o card num prompt (etapa rápida e barata, sem editar
# nada). Aceita alias: sonnet, opus, haiku, fable - ou um nome completo de modelo.
CLAUDE_PROMPT_MODEL=haiku
# Timeout (segundos) dessa etapa de rascunho do prompt.
CLAUDE_PROMPT_TIMEOUT_SECONDS=300

# Modelo e effort usados pra EXECUTAR a tarefa de verdade (edita arquivos, roda
# comandos etc) só entram como FALLBACK: normalmente quem escolhe é a própria etapa
# de rascunho do prompt (proporcional à complexidade de cada card - ver
# claude_prompt.py), registrado no comentário do card e na mensagem do Telegram. Só
# são usados se essa escolha não vier ou vier inválida. Deixe em branco pra cair no
# modelo padrão da sua conta/assinatura (efeito equivalente a não escolher nada).
CLAUDE_EXEC_MODEL=opus
CLAUDE_EXEC_EFFORT=
# Tempo máximo (segundos) que essa execução pode rodar antes de ser considerada
# travada. 2700 = 45 minutos.
CLAUDE_RUN_TIMEOUT_SECONDS=2700

# --- Pausa preventiva por uso (ver automation/SETUP.md, passo 6) ---------------
# Ao chegar nessa fração da janela de 5h da conta, a automação para de iniciar
# chamadas ao Claude Code e retoma sozinha no reset. Aceita 0.8 ou 80. Use 1 (100%)
# pra ficar só com o retry reativo de limite de uso.
USAGE_PAUSE_THRESHOLD=0.8
# De quanto em quanto tempo (segundos) a pausa confere de novo se já pode retomar.
USAGE_PAUSE_CHECK_SECONDS=60
# Só pro FALLBACK (quando o Claude Code não informa a utilização oficial - CLI
# antiga ou login por API key): duração da janela em segundos e "capacidade" dela em
# US$ (soma de total_cost_usd). Vazio = estimativa desligada. Veja a limitação no
# SETUP.md antes de preencher.
USAGE_WINDOW_SECONDS=18000
USAGE_WINDOW_CAPACITY_USD=

# --- Telegram (avisos) --------------------------------------------------------
# Token do bot: fale com @BotFather no Telegram, /newbot
TELEGRAM_BOT_TOKEN=
# Seu chat id: fale com @userinfobot no Telegram (ele te devolve o ID na hora)
TELEGRAM_CHAT_ID=

# --- Git ------------------------------------------------------------------------
# Branch em que o Claude Code trabalha DIRETO (sem branch por card) e pra onde dá
# push automaticamente depois de cada execução.
BASE_BRANCH=main

# --- Geral ----------------------------------------------------------------------
# De quanto em quanto tempo (segundos) o watcher confere o board.
POLL_INTERVAL_SECONDS=30
