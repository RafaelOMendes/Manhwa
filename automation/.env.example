# Copie este arquivo para "automation/.env" e preencha os valores.
# NUNCA commite o .env de verdade (ele já está no .gitignore).
# O passo a passo completo de onde conseguir cada valor está em automation/SETUP.md.

# --- Trello -----------------------------------------------------------------
# Chave e token de API: https://trello.com/power-ups/admin -> "New" -> API Key
# (o token é gerado clicando no link "Token" que aparece do lado da API Key)
TRELLO_KEY=
TRELLO_TOKEN=
# ID do board: abra o board, adicione ".json" no final da URL, procure por "id" no topo
TRELLO_BOARD_ID=

# Nomes EXATOS das listas (colunas) do seu board do Trello, como aparecem na tela.
TRELLO_LIST_DOING=Em Andamento
TRELLO_LIST_DEV=Em Desenvolvimento
TRELLO_LIST_TEST=Teste
TRELLO_LIST_DONE=Concluído

# --- Gemini (geração do prompt) ---------------------------------------------
# Chave de API gratuita em https://aistudio.google.com/apikey
# (é diferente da assinatura do app Gemini/Gemini Advanced)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# --- Telegram (avisos) --------------------------------------------------------
# Token do bot: fale com @BotFather no Telegram, /newbot
TELEGRAM_BOT_TOKEN=
# Seu chat id: fale com @userinfobot no Telegram (ele te devolve o ID na hora)
TELEGRAM_CHAT_ID=

# --- Claude Code CLI ----------------------------------------------------------
# Deixe em branco se "claude" já funciona no seu terminal (PATH). Só preencha se
# precisar apontar pro executável exato.
CLAUDE_CLI_PATH=
# Tempo máximo (segundos) que uma execução do Claude Code pode rodar antes de ser
# considerada travada. 2700 = 45 minutos.
CLAUDE_RUN_TIMEOUT_SECONDS=2700

# --- Git ------------------------------------------------------------------------
# Branch a partir da qual cada card cria sua própria branch, e pra onde ela é
# mergeada quando o card é aprovado (movido pra "Concluído").
BASE_BRANCH=main
# true = depois do merge, dá "git push origin <BASE_BRANCH>" automaticamente.
# Comece com false e ligue depois de confiar no fluxo.
PUSH_TO_REMOTE=false

# --- EAS Build (mobile) -------------------------------------------------------
EAS_CLI_PATH=eas
EAS_BUILD_PROFILE=preview
EAS_BUILD_TIMEOUT_SECONDS=1800

# --- Geral ----------------------------------------------------------------------
# De quanto em quanto tempo (segundos) o watcher confere o board.
POLL_INTERVAL_SECONDS=30
